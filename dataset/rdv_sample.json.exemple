    },
    {
     "type": "plain",
     "text": "\nНАБИУЛЛИНА: ВИДИМ, ЧТО ОЖИДАНИЯ РЫНКА ПО ДАЛЬНЕЙШЕМУ СНИЖЕНИЮ СТАВКИ СТАЛИ СДЕРЖАННЕЕ; МЫ БУДЕМ ДВИГАТЬСЯ, ТЩАТЕЛЬНО ВЫВЕРЯЯ ШАГИ"
