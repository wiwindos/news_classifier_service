     "text": "#Макро"
    },
    "\nНАБИУЛЛИНА: ВИДИМ, ЧТО ОЖИДАНИЯ РЫНКА ПО ДАЛЬНЕЙШЕМУ СНИЖЕНИЮ СТАВКИ СТАЛИ СДЕРЖАННЕЕ; МЫ БУДЕМ ДВИГАТЬСЯ, ТЩАТЕЛЬНО ВЫВЕРЯЯ ШАГИ"
   ],
   "text_entities": [
