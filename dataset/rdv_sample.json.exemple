   "from": "РынкиДеньгиВласть | РДВ",
   "from_id": "channel1075101206",
   "poll": {
    "question": "В какой класс актива вы сейчас инвестируете больше всего денег?",
    "closed": false,
    "total_voters": 7477,
    "answers": [
     {
      "text": "Акции",
      "voters": 2234,
      "chosen": false
     },
     {
      "text": "Флоатеры, фонды денежного рынка",
      "voters": 650,
      "chosen": false
     },
     {
      "text": "Короткие облигации с фиксированным купоном",
      "voters": 616,
      "chosen": false
     },
     {
      "text": "Длинные ОФЗ",
      "voters": 895,
