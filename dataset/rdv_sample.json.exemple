   "text": [
    {
     "type": "bold",
     "text": "Аудитория Яндекса (YDEX) как процент населения РФ"
    },
    ". ",
    {
     "type": "hashtag",
     "text": "#stoxy"
    },
    " ",
    {
     "type": "hashtag",
     "text": "#цифры"
